rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        (request.auth.token.phone_number != null && request.auth.token.phone_number == resource.data.phone)
      );
    }

    function isMerchantOwner(merchantId) {
      return isAuthenticated() && (
        request.auth.uid == merchantId ||
        (resource.data.ownerPhone != null && request.auth.token.phone_number == resource.data.ownerPhone) ||
        (request.auth.token.merchantId == merchantId) ||
        isAdmin()
      );
    }

    // Users Collection (Strict Owner or Admin Access)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin())
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin']));
      allow delete: if isAdmin();
    }

    // Merchants Collection
    match /merchants/{merchantId} {
      // Public can read active merchants (directory & rewards)
      allow read: if resource.data.status == 'active' || isMerchantOwner(merchantId) || isAdmin();
      // Onboarding merchant can submit application with status 'pending'
      allow create: if isAuthenticated() && (
        request.resource.data.status == 'pending' || isAdmin()
      );
      // Merchant can update non-critical business details; status changes require admin
      allow update: if isAdmin() || (
        isMerchantOwner(merchantId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedAt', 'bKashTxId', 'packageDuration'])
      );
      allow delete: if isAdmin();
    }

    // Cards Collection (Customer Loyalty Cards)
    match /cards/{cardId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.customerPhone == request.auth.token.phone_number ||
        request.auth.token.merchantId == resource.data.merchantId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      // Only authorized updates (incremental stamping, voucher attach)
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        request.auth.token.merchantId == resource.data.merchantId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Stamps Collection (Transaction Records)
    match /stamps/{stampId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.customerPhone == request.auth.token.phone_number ||
        resource.data.merchantId == request.auth.token.merchantId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      // Stamp transactions are immutable once written
      allow update, delete: if isAdmin();
    }

    // Vouchers Collection (Rewards)
    match /vouchers/{voucherId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.customerPhone == request.auth.token.phone_number ||
        resource.data.merchantId == request.auth.token.merchantId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      // Merchants can redeem; once redeemed it cannot be reset to false
      allow update: if isAuthenticated() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemed', 'redeemedAt']) &&
         resource.data.redeemed == false && request.resource.data.redeemed == true) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Pending Approvals (For counter staff validation)
    match /pendingApprovals/{approvalId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.customerPhone == request.auth.token.phone_number ||
        resource.data.merchantId == request.auth.token.merchantId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      // Resolution can only occur once from pending -> approved/rejected
      allow update: if isAuthenticated() && (
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected']
      );
      allow delete: if isAdmin();
    }

    // Reward Programs Collection
    match /rewardPrograms/{programId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isAuthenticated() && (
        request.auth.token.merchantId == request.resource.data.merchantId ||
        isAdmin()
      );
    }

    // Immutable Stamps Ledger (Fintech audit logs - Append Only)
    match /stamps_ledger/{stampId} {
      allow read: if isAuthenticated() && (
        resource.data.merchantId == request.auth.token.merchantId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only immutable ledger
    }

    // Daily Analytics Aggregates
    match /analytics_daily/{dailyId} {
      allow read: if isAuthenticated() && (
        resource.data.merchantId == request.auth.token.merchantId ||
        isAdmin()
      );
      allow write: if isAdmin();
    }
  }
}
