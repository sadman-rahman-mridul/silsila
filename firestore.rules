rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Customer profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Merchant profiles & directory
    match /merchants/{merchantId} {
      allow read, write: if true;
    }

    // Customer loyalty stamp cards
    match /cards/{cardId} {
      allow read, write: if true;
    }

    // Stamp transaction records
    match /stamps/{stampId} {
      allow read, write: if true;
    }

    // Reward vouchers
    match /vouchers/{voucherId} {
      allow read, write: if true;
    }

    // Counter staff stamp & voucher validation
    match /pendingApprovals/{approvalId} {
      allow read, write: if true;
    }

    // Public reward catalog
    match /rewardPrograms/{programId} {
      allow read, write: if true;
    }

    // Append-only ledger
    match /stamps_ledger/{stampId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Daily analytics aggregates
    match /analytics_daily/{dailyId} {
      allow read, write: if true;
    }
  }
}
